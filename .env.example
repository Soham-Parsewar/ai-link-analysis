APP_NAME="AI Website Link Analysis API"
APP_ENV="development"
HOST="0.0.0.0"
PORT=4000

# LLM Configuration
# Default: 'mock' (runs offline using built-in Grounded Heuristic Engine, NO API key required)
# Options: mock, openai, gemini
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Website Extraction & Security Limits
REQUEST_TIMEOUT=15
MAX_HTML_SIZE_MB=2
MAX_CONTENT_LENGTH=12000
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 (AI-Link-Analyzer/1.0)"

# Caching Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Logging Configuration
LOG_LEVEL="INFO"
