APP_NAME="AI Website Link Analysis API"
APP_ENV="development"
HOST="0.0.0.0"
PORT=4000

# LLM Configuration
# Options: openai, gemini, mock (mock provides realistic grounded analysis without external API keys for testing)
LLM_PROVIDER="openai"
LLM_API_KEY="your_api_key_here"
LLM_MODEL="gpt-4o-mini"

# Website Extraction & Security Limits
REQUEST_TIMEOUT=15
MAX_HTML_SIZE_MB=2
MAX_CONTENT_LENGTH=12000
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 (AI-Link-Analyzer/1.0)"

# Caching Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Logging Configuration
LOG_LEVEL="INFO"
